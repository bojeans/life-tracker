# Copy to .env and fill in. See the README for details.

# Local Postgres from docker-compose (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_tracker"

# Required by Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app (only needed to sign in as the owner; the demo and shared
# views work without it).
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email of the GitHub account allowed owner access
OWNER_EMAIL=""
