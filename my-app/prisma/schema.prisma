generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // Use the WASM query compiler + a JS driver adapter (see src/lib/db.ts)
  // instead of the native Rust query engine, so there's no platform-specific
  // binary to bundle/locate in serverless functions (the rhel-openssl errors).
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth v5 required tables ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shareToken String? @unique @default(cuid())
  // When true, this account is a public sandbox: visitors holding its
  // shareToken can act as it (add/edit/delete) via demo mode. Never set on a
  // real user — it's the gate that protects owner data.
  isDemo     Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  transactions  Transaction[]
  dietEntries     DietEntry[]
  weightEntries   WeightEntry[]
  foodItems       FoodItem[]
  exerciseEntries ExerciseEntry[]
  profile         Profile?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Finance ──────────────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

// Where a transaction originated. MANUAL is the default; CSV and SHARESIGHT
// are reserved for future import paths (Google Sheets export, Sharesight API).
enum TransactionSource {
  MANUAL
  CSV
  SHARESIGHT
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("AUD")
  category    String
  description String?
  date        DateTime
  source      TransactionSource @default(MANUAL)
  // Stable id from the source system (CSV row hash / Sharesight id) for
  // dedup on re-import. Null for manual entries.
  externalId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevent importing the same external record twice. Multiple NULLs are
  // allowed by Postgres, so manual entries are unaffected.
  @@unique([userId, source, externalId])
  @@index([userId, date])
}

// ── Health ───────────────────────────────────────────────────────────────────

// Where a health record originated. MANUAL is the default; CSV is the Google
// Sheets import path; OPEN_FOOD_FACTS marks rows prefilled from a food search
// or barcode scan.
enum HealthSource {
  MANUAL
  CSV
  OPEN_FOOD_FACTS
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// A logged food. Supports two modes: a single food item (name + quantity +
// per-serving macros, optionally from a barcode/search) OR a daily total
// (isDailyTotal=true, mealType/quantity null) for a whole-day summary row.
model DietEntry {
  id           String        @id @default(cuid())
  userId       String
  name         String
  date         DateTime
  mealType     MealType?
  isDailyTotal Boolean       @default(false)
  quantityG    Decimal?      @db.Decimal(10, 2)
  calories     Decimal       @db.Decimal(10, 2)
  protein      Decimal       @db.Decimal(10, 2)
  carbs        Decimal       @db.Decimal(10, 2)
  fat          Decimal       @db.Decimal(10, 2)
  barcode      String?
  // Optional link to the catalog item this was logged from. The macros above
  // are a snapshot at the logged quantity, so editing the catalog item later
  // does not rewrite history. SetNull keeps the entry if the item is deleted.
  foodItemId   String?
  source       HealthSource  @default(MANUAL)
  externalId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@unique([userId, source, externalId])
  @@index([userId, date])
}

// A reusable per-user food catalog ("pantry"). Built once by scanning/searching
// (Open Food Facts) or manual entry, then picked from when logging diet entries.
// All nutrients are stored per 100g; common micros are optional (OFF coverage
// varies). Deduped by barcode per user.
model FoodItem {
  id           String       @id @default(cuid())
  userId       String
  name         String
  brand        String?
  category     String?
  barcode      String?
  servingSizeG Decimal?     @db.Decimal(10, 2)
  // per-100g macros
  calories     Decimal      @db.Decimal(10, 2)
  protein      Decimal      @db.Decimal(10, 2)
  carbs        Decimal      @db.Decimal(10, 2)
  fat          Decimal      @db.Decimal(10, 2)
  // per-100g common micros (optional)
  fiber        Decimal?     @db.Decimal(10, 2)
  sugar        Decimal?     @db.Decimal(10, 2)
  sodium       Decimal?     @db.Decimal(10, 2)
  satFat       Decimal?     @db.Decimal(10, 2)
  source       HealthSource @default(MANUAL)
  externalId   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries DietEntry[]

  // A null barcode is allowed for many manual items (Postgres allows multiple
  // NULLs); scanned items dedupe on their barcode.
  @@unique([userId, barcode])
  @@index([userId, name])
}

enum Sex {
  MALE
  FEMALE
}

// Baseline (non-exercise) activity level. Logged workouts are added on top, so
// keep this at your day-to-day movement excluding deliberate exercise.
enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

// One-per-user profile holding the inputs for BMR/TDEE (energy-balance) math.
model Profile {
  id            String        @id @default(cuid())
  userId        String        @unique
  heightCm      Decimal       @db.Decimal(5, 1)
  birthYear     Int
  sex           Sex
  activityLevel ActivityLevel @default(LIGHT)
  bodyFatPct    Decimal?      @db.Decimal(4, 1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A logged workout/activity. caloriesBurned is computed from MET × bodyweight ×
// duration (editable), or entered directly. steps/distance are optional extras.
model ExerciseEntry {
  id             String       @id @default(cuid())
  userId         String
  date           DateTime
  activity       String
  durationMin    Decimal?     @db.Decimal(7, 1)
  met            Decimal?     @db.Decimal(4, 1)
  caloriesBurned Decimal      @db.Decimal(8, 1)
  steps          Int?
  distanceKm     Decimal?     @db.Decimal(7, 2)
  note           String?
  source         HealthSource @default(MANUAL)
  externalId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, date])
}

// A bodyweight measurement, for weight-management trend analysis.
model WeightEntry {
  id         String       @id @default(cuid())
  userId     String
  date       DateTime
  weightKg   Decimal      @db.Decimal(6, 2)
  note       String?
  source     HealthSource @default(MANUAL)
  externalId String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, date])
}
