generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // Use the WASM query compiler + a JS driver adapter (see src/lib/db.ts)
  // instead of the native Rust query engine, so there's no platform-specific
  // binary to bundle/locate in serverless functions (the rhel-openssl errors).
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth v5 required tables ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wealthAccounts   WealthAccount[]
  balanceSnapshots BalanceSnapshot[]

  shareToken String? @unique @default(cuid())
  // When true, this account is a public sandbox: visitors holding its
  // shareToken can act as it (add/edit/delete) via demo mode. Never set on a
  // real user — it's the gate that protects owner data.
  isDemo     Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  transactions  Transaction[]
  dietEntries     DietEntry[]
  weightEntries   WeightEntry[]
  foodItems       FoodItem[]
  exerciseEntries ExerciseEntry[]
  bloodPressureEntries BloodPressureEntry[]
  recipes         Recipe[]
  profile         Profile?
  mediaItems      MediaItem[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Finance ──────────────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  // A move between the user's own accounts (e.g. bank → Sharesies). Excluded
  // from income/expense/net totals — it doesn't change net worth.
  TRANSFER
}

// Where a transaction originated. MANUAL is the default; CSV and SHARESIGHT
// are reserved for future import paths (Google Sheets export, Sharesight API).
enum TransactionSource {
  MANUAL
  CSV
  SHARESIGHT
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("AUD")
  category    String
  description String?
  date        DateTime
  source      TransactionSource @default(MANUAL)
  // Stable id from the source system (CSV row hash / Sharesight id) for
  // dedup on re-import. Null for manual entries.
  externalId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevent importing the same external record twice. Multiple NULLs are
  // allowed by Postgres, so manual entries are unaffected.
  @@unique([userId, source, externalId])
  @@index([userId, date])
}

// Asset class for a net-worth account, so balances roll up into a composition.
enum AssetClass {
  CASH
  SHARES
  CRYPTO
  SUPER
}

// Whether an account adds to or subtracts from net worth. Liabilities (e.g. a
// student loan) hold a positive balance owed and are subtracted.
enum AccountKind {
  ASSET
  LIABILITY
}

// A place wealth is held (e.g. Kiwibank, Sharesies, crypto.com). Its balance
// over time is captured as BalanceSnapshots; net worth is the sum of each
// account's latest balance, converted to the base currency.
model WealthAccount {
  id          String     @id @default(cuid())
  userId      String
  name        String
  institution String?
  kind        AccountKind @default(ASSET)
  assetClass  AssetClass
  currency    String     @default("NZD")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots BalanceSnapshot[]

  @@index([userId])
}

// A point-in-time balance for one account. One per account per date (upserted),
// so re-recording a month overwrites rather than duplicates.
model BalanceSnapshot {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  date      DateTime
  balance   Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account WealthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([userId, date])
}

// ── Health ───────────────────────────────────────────────────────────────────

// Where a health record originated. MANUAL is the default; CSV is the Google
// Sheets import path; OPEN_FOOD_FACTS marks rows prefilled from a food search
// or barcode scan.
enum HealthSource {
  MANUAL
  CSV
  OPEN_FOOD_FACTS
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// A logged food. Supports two modes: a single food item (name + quantity +
// per-serving macros, optionally from a barcode/search) OR a daily total
// (isDailyTotal=true, mealType/quantity null) for a whole-day summary row.
model DietEntry {
  id           String        @id @default(cuid())
  userId       String
  name         String
  date         DateTime
  mealType     MealType?
  isDailyTotal Boolean       @default(false)
  quantityG    Decimal?      @db.Decimal(10, 2)
  calories     Decimal       @db.Decimal(10, 2)
  protein      Decimal       @db.Decimal(10, 2)
  carbs        Decimal       @db.Decimal(10, 2)
  fat          Decimal       @db.Decimal(10, 2)
  barcode      String?
  // Optional link to the catalog item this was logged from. The macros above
  // are a snapshot at the logged quantity, so editing the catalog item later
  // does not rewrite history. SetNull keeps the entry if the item is deleted.
  foodItemId   String?
  source       HealthSource  @default(MANUAL)
  externalId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@unique([userId, source, externalId])
  @@index([userId, date])
}

// A reusable per-user food catalog ("pantry"). Built once by scanning/searching
// (Open Food Facts) or manual entry, then picked from when logging diet entries.
// All nutrients are stored per 100g; common micros are optional (OFF coverage
// varies). Deduped by barcode per user.
model FoodItem {
  id           String       @id @default(cuid())
  userId       String
  name         String
  brand        String?
  category     String?
  barcode      String?
  // A serving as the user entered it (e.g. 1 "tbsp"), plus its gram equivalent.
  // servingSizeG stays canonical for macro math; amount/unit are for display
  // and to default the logging unit. Null unit ⇒ plain grams / OFF import.
  servingAmount Decimal?    @db.Decimal(10, 3)
  servingUnit  String?
  servingSizeG Decimal?     @db.Decimal(10, 2)
  // per-100g macros
  calories     Decimal      @db.Decimal(10, 2)
  protein      Decimal      @db.Decimal(10, 2)
  carbs        Decimal      @db.Decimal(10, 2)
  fat          Decimal      @db.Decimal(10, 2)
  // per-100g common micros (optional)
  fiber        Decimal?     @db.Decimal(10, 2)
  sugar        Decimal?     @db.Decimal(10, 2)
  sodium       Decimal?     @db.Decimal(10, 2)
  satFat       Decimal?     @db.Decimal(10, 2)
  source       HealthSource @default(MANUAL)
  externalId   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     DietEntry[]
  recipeUses  RecipeIngredient[]

  // A null barcode is allowed for many manual items (Postgres allows multiple
  // NULLs); scanned items dedupe on their barcode.
  @@unique([userId, barcode])
  @@index([userId, name])
}

// A reusable meal/smoothie composed of pantry items (e.g. "100g chicken + half
// an onion"). `servings` lets a batch be logged a portion at a time. Logging a
// recipe writes a single DietEntry with the summed (÷ servings) macros, so it
// flows into the normal diet analytics.
model Recipe {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  servings    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([userId, name])
}

// One pantry item in a recipe at a gram quantity. Macros are a per-100g
// snapshot (like DietEntry) so the recipe survives the catalog item being
// edited or deleted, and grams can be rescaled without re-fetching. foodItemId
// is kept (SetNull) only as a back-reference.
model RecipeIngredient {
  id         String   @id @default(cuid())
  recipeId   String
  foodItemId String?
  name       String
  quantityG  Decimal  @db.Decimal(10, 2)
  // per-100g snapshot
  calories   Decimal  @db.Decimal(10, 2)
  protein    Decimal  @db.Decimal(10, 2)
  carbs      Decimal  @db.Decimal(10, 2)
  fat        Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)

  recipe   Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@index([recipeId])
}

enum Sex {
  MALE
  FEMALE
}

// Baseline (non-exercise) activity level. Logged workouts are added on top, so
// keep this at your day-to-day movement excluding deliberate exercise.
enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

// One-per-user profile holding the inputs for BMR/TDEE (energy-balance) math.
model Profile {
  id            String        @id @default(cuid())
  userId        String        @unique
  heightCm      Decimal       @db.Decimal(5, 1)
  birthYear     Int
  sex           Sex
  activityLevel ActivityLevel @default(LIGHT)
  bodyFatPct    Decimal?      @db.Decimal(4, 1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A logged workout/activity. caloriesBurned is computed from MET × bodyweight ×
// duration (editable), or entered directly. steps/distance are optional extras.
model ExerciseEntry {
  id             String       @id @default(cuid())
  userId         String
  date           DateTime
  activity       String
  durationMin    Decimal?     @db.Decimal(7, 1)
  met            Decimal?     @db.Decimal(4, 1)
  caloriesBurned Decimal      @db.Decimal(8, 1)
  steps          Int?
  distanceKm     Decimal?     @db.Decimal(7, 2)
  note           String?
  source         HealthSource @default(MANUAL)
  externalId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, date])
}

// A blood-pressure reading. systolic/diastolic are whole mmHg; pulse (bpm) is
// optional since not every reading records it. Classified (AHA categories) at
// read time in analytics rather than stored, so the thresholds can evolve.
model BloodPressureEntry {
  id         String       @id @default(cuid())
  userId     String
  date       DateTime
  systolic   Int
  diastolic  Int
  pulse      Int?
  note       String?
  source     HealthSource @default(MANUAL)
  externalId String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, date])
}

// A bodyweight measurement, for weight-management trend analysis.
model WeightEntry {
  id         String       @id @default(cuid())
  userId     String
  date       DateTime
  weightKg   Decimal      @db.Decimal(6, 2)
  note       String?
  source     HealthSource @default(MANUAL)
  externalId String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, date])
}

// ── Travel ───────────────────────────────────────────────────────────────────

enum MediaType {
  PHOTO
  VIDEO
}

// A photo or short video. The app is a metadata *index*: the bytes never live
// in Postgres — they sit in object storage (or /public for the demo) and are
// referenced by storageKey/thumbKey. See src/features/travel/media-url.ts for
// how a key becomes a loadable URL (today a /public path; later a signed R2
// URL). Grids load only the small thumbKey; originals load on click.
model MediaItem {
  id          String    @id @default(cuid())
  userId      String
  type        MediaType @default(PHOTO)
  storageKey  String // object key / path to the original
  thumbKey    String? // object key / path to a small thumbnail
  title       String?
  album       String? // a "folder" — a trip or country
  takenAt     DateTime? // capture time (from EXIF when ingested)
  lat         Float?
  lng         Float?
  width       Int?
  height      Int?
  durationSec Int? // videos only
  tags        String[]  @default([])
  source      String    @default("MANUAL")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Keyset pagination orders by (takenAt desc, id desc); this index backs it.
  @@index([userId, takenAt, id])
}
